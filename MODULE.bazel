module(
    name = "kabudachi",
    version = "0.1.0",
)

# --- Rust toolchain ---
bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # At least 1.98: older rustc strips Mach-O with an llvm-objcopy that
    # leaves the symbol string table not 8-byte aligned. macOS 27's dyld
    # refuses to load such a dylib, and every opt-mode (exec) proc-macro is
    # stripped. 1.98.0 is the newest release rules_rust 0.74.0 has checksums
    # for; a newer one downloads unverified.
    versions = ["1.98.0"],
)

# --- Protobuf (Rust wire types from proto/ via prost) ---
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_rust_prost", version = "0.74.0")

# rules_rust_prost self-registers a default toolchain bundling its own
# pinned `prost`, separate from the workspace's crate_universe `prost` (see
# tools/rust_prost_toolchain/BUILD.bazel for why that breaks net/, which
# needs `prost::Message` to be the same trait for both proto-generated types
# and its own encode/decode calls). A root module's own registration takes
# priority over one a dependency (rules_rust_prost) registers for itself.
register_toolchains("//tools/rust_prost_toolchain:prost_toolchain")

# --- crate_universe (third-party crates for core/bindings) ---
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml", "//core:Cargo.toml", "//bindings:Cargo.toml", "//proto:Cargo.toml", "//net:Cargo.toml", "//testkit:Cargo.toml"],
)

# Not a direct Cargo dependency of any workspace member — pulled in only so
# tools/rust_prost_toolchain:prost_toolchain can hand the prost codegen
# plugin a `prost_types` from this same crate_universe (the toolchain rule
# needs a value for it even though this workspace's .proto files don't use
# google.protobuf's well-known types yet).
crate.spec(
    package = "prost-types",
    version = "0.13",
)

use_repo(crate, "crates")

# --- PyO3 extension support ---
# `platforms` is required here (not just transitively via rules_rust)
# because pyo3_extension's internal select() on @platforms//os:macos
# needs it directly.
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust_pyo3", version = "0.74.0")

register_toolchains(
    "@rules_rust_pyo3//toolchains:toolchain",
    "@rules_rust_pyo3//toolchains:rust_toolchain",
)

# --- Python toolchain + uv-managed deps for runtime/ ---
# The interpreter Bazel runs Python on. rules_python defaults to 3.11, but
# runtime/ requires >=3.12 and uv.lock only holds wheels for 3.12+, so compiled
# packages (pydantic-core, wrapt) could not be installed under 3.11.
bazel_dep(name = "rules_python", version = "1.6.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

bazel_dep(name = "aspect_rules_py", version = "1.12.1")

interpreters = use_extension("@aspect_rules_py//py/unstable:extension.bzl", "python_interpreters")
interpreters.toolchain(python_version = "3.12")
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

py_tools = use_extension("@aspect_rules_py//py:extensions.bzl", "py_tools")
py_tools.rules_py_tools()
use_repo(py_tools, "rules_py_tools")

register_toolchains("@rules_py_tools//:all")

uv_bin = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv_bin")
uv_bin.toolchain(version = "0.11.6")
use_repo(uv_bin, "uv")

register_toolchains("@uv//:all")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(hub_name = "pypi")
uv.project(
    hub_name = "pypi",
    # Every dependency installs from a wheel, so no source build is ever made
    # and no build tools need to be in the lock.
    default_build_dependencies = [],
    lock = "//runtime:uv.lock",
    pyproject = "//runtime:pyproject.toml",
)
use_repo(uv, "pypi")

# --- Gazelle (Python BUILD file generation) ---
bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.26")
