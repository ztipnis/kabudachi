load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# The library in this package goes to CI's remote cache (CircleCI's
# with_tool_cache, billed per GB stored), so a change that leaves it alone
# does not rebuild it.

# Test-only support: only other packages' test targets may depend on it.
rust_library(
    name = "testkit",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_testkit",
    edition = "2024",
    testonly = True,
    deps = all_crate_deps(normal = True) + ["//core"],
    visibility = ["//core:__pkg__", "//net:__pkg__"],
)

rust_test(
    name = "testkit_integration_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/faulting_authority.rs",
    edition = "2024",
    size = "small",
    tags = ["no-remote-cache"],
    deps = [":testkit", "//core"],
)
