load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# Test-only support: only other packages' test targets may depend on it.
rust_library(
    name = "testkit",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_testkit",
    edition = "2024",
    testonly = True,
    deps = all_crate_deps(normal = True) + ["//core"],
    visibility = ["//core:__pkg__", "//net:__pkg__"],
)

rust_test(
    name = "testkit_test",
    crate = ":testkit",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)
