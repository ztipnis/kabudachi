load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//bindings:defs.bzl", "PYTHON_EXTENSION_RUSTC_FLAGS")

# The shared library in this package goes to CI's remote cache (CircleCI's
# with_tool_cache, billed per GB stored), so a change that leaves it alone
# does not rebuild it. The extension copy (_native_so) and its py_library
# wrapper (_native) are tagged no-remote-cache because they are a second copy
# of the shared library.

# The PyO3 extension, built as a plain shared library against Python's stable
# ABI (see bindings/Cargo.toml and MODULE.bazel). The crate name is the
# module's own name: Python looks for `PyInit__native` in the file.
rust_shared_library(
    name = "_native_shared",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "_native",
    edition = "2024",
    rustc_flags = PYTHON_EXTENSION_RUSTC_FLAGS,
    visibility = ["//visibility:private"],
    # The networked runtime hosts a net worker, with a Redis authority.
    deps = [
        "//bindings/py_backend",
        "//core:core",
        "//net",
        "//redis_authority",
        "//redis_result_backend",
        "@crates//:axum",
        "@crates//:log",
        "@crates//:pyo3",
        "@crates//:pyo3-log",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

# Python imports an extension from a file named `<module>.so` on macOS and
# Linux alike, though macOS names a shared library `.dylib`. The wheel
# (//runtime:kabudachi_wheel) packages this copy.
copy_file(
    name = "_native_so",
    src = ":_native_shared",
    out = "kabudachi/_native.so",
    tags = ["no-remote-cache"],
    visibility = ["//runtime:__pkg__"],
)

py_library(
    name = "_native",
    data = [":_native_so"],
    # Puts this package's own directory (bindings/) on sys.path so the
    # compiled extension resolves as top-level `kabudachi._native` rather
    # than `bindings.kabudachi._native`. runtime/src/kabudachi/__init__.py
    # extends its own __path__ (pkgutil-style) so this merges into the
    # same `kabudachi` package as the pure-Python sources.
    imports = ["."],
    tags = ["no-remote-cache"],
    visibility = ["//runtime:__subpackages__"],
)
