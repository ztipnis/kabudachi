load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# Every first-party target is tagged no-remote-cache: CI's remote cache
# (CircleCI's with_tool_cache, billed per GB stored) then holds only
# third-party outputs, which do not change between runs. The local disk
# cache still stores these targets.

rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_core",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = all_crate_deps(normal = True) + ["//proto:kabudachi_prost"],
    visibility = ["//bindings:__pkg__", "//net:__pkg__", "//testkit:__pkg__"],
)

rust_test(
    name = "core_test",
    crate = ":core",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = all_crate_deps(normal_dev = True),
)

# One integration-test binary for core, with a module per area under
# `tests/`. proptest replays the cases saved beside each test's source, which
# it finds by `file!()` from the working directory, so both are in the
# runfiles.
#
# Medium (300 s default timeout) gives the whole crate's tests, which share one
# process, headroom on slow CI hosts; they take about 6 s on a laptop.
# rules_rust cannot shard libtest (every shard would run the full binary), so
# there is no shard_count.
rust_test(
    name = "core_integration_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/core_integration.rs",
    data = glob(["tests/proptest/*.proptest-regressions", "tests/proptest/*.rs"]),
    edition = "2024",
    # The seeded scenarios and the property tests read their seeds and case
    # counts from these variables, so the cached result must change with them.
    env_inherit = ["KABUDACHI_SIM_SEEDS", "PROPTEST_CASES", "PROPTEST_RNG_SEED"],
    size = "medium",
    tags = ["no-remote-cache"],
    deps = [":core", "//testkit"] + all_crate_deps(normal = True, normal_dev = True),
)
