load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# Every first-party target is tagged no-remote-cache: CI's remote cache
# (CircleCI's with_tool_cache, billed per GB stored) then holds only
# third-party outputs, which do not change between runs. The local disk
# cache still stores these targets.

rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_core",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = all_crate_deps(normal = True) + ["//proto:kabudachi_prost"],
    visibility = ["//bindings:__pkg__", "//net:__pkg__", "//testkit:__pkg__"],
)

rust_test(
    name = "core_test",
    crate = ":core",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = all_crate_deps(normal_dev = True),
)

# One integration-test crate per area of core (README §26 testing strategy).
# Each is one Bazel target, so a change to one source file reruns only the
# areas that depend on it; `tests/support/**` is shared by every crate.
[
    rust_test(
        name = area + "_test",
        srcs = glob(["tests/" + area + "/**/*.rs", "tests/support/**/*.rs"]),
        crate_root = "tests/" + area + "/main.rs",
        edition = "2024",
        tags = ["no-remote-cache"],
        deps = [":core", "//testkit"] + all_crate_deps(normal = True, normal_dev = True),
    )
    for area in ["election", "scenario", "scheduler", "configuration"]
]

# proptest replays the cases saved beside each test's source, which it finds
# by `file!()` from the working directory, so both are in the runfiles.
rust_test(
    name = "proptest_test",
    srcs = glob(["tests/proptest/**/*.rs", "tests/support/**/*.rs"]),
    crate_root = "tests/proptest/main.rs",
    data = glob(["tests/proptest/*.proptest-regressions", "tests/proptest/*.rs"]),
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = [":core", "//testkit"] + all_crate_deps(normal = True, normal_dev = True),
)
