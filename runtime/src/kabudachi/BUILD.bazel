load("@aspect_rules_py//py:defs.bzl", "py_library")

py_library(
    name = "kabudachi",
    # Listed file by file, not globbed: Gazelle only indexes the modules a
    # rule names in srcs, so with a glob no `kabudachi.*` import resolves.
    srcs = [
        "__init__.py",
        "_checks.py",
        "_child.py",
        "body.py",
        "composites.py",
        "concurrency_places.py",
        "config.py",
        "dataclass_serializer.py",
        "errors.py",
        "execution.py",
        "flow.py",
        "handle.py",
        "hosted_work.py",
        "ipc.py",
        "lifecycle.py",
        "logging.py",
        "native_protocol.py",
        "options.py",
        "pool.py",
        "protobuf_serializer.py",
        "pydantic_serializer.py",
        "registry.py",
        "run_info.py",
        "runner.py",
        "schemas.py",
        "serializers.py",
        "session.py",
        "status.py",
        "task_table.py",
        "tasks.py",
    ],
    imports = [".."],
    visibility = ["//runtime:__subpackages__"],  # keep
    # //bindings:_native is a Rust-built (non-Python) target Gazelle cannot
    # discover from an import statement. It must live here (not only on
    # individual test targets) so that every consumer of this py_library
    # gets //bindings/ on sys.path via Bazel's imports propagation, and
    # therefore can resolve `from kabudachi import _native`.
    deps = [
        "//bindings:_native",  # keep
        "@pypi//asgiref",  # keep
        "@pypi//protobuf",  # keep
        "@pypi//pydantic",  # keep
        "@pypi//wrapt",  # keep
    ],
)

# Every file of the package a wheel ships: what uv_build puts in one (all of
# src/kabudachi except bytecode and, by pyproject.toml's wheel-exclude, this
# BUILD file). //runtime:kabudachi_wheel packages it.
filegroup(
    name = "distribution",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
    visibility = ["//runtime:__pkg__"],
)
