load("@aspect_rules_py//py:defs.bzl", "py_library")

py_library(
    name = "kabudachi",
    # Listed file by file, not globbed: Gazelle only indexes the modules a
    # rule names in srcs, so with a glob no `kabudachi.*` import resolves.
    srcs = [
        "__init__.py",
        "body.py",
        "composites.py",
        "config.py",
        "errors.py",
        "flow.py",
        "handle.py",
        "native_protocol.py",
        "options.py",
        "protobuf_serializer.py",
        "registry.py",
        "runner.py",
        "serializers.py",
        "session.py",
        "task_table.py",
        "tasks.py",
    ],
    imports = [".."],
    visibility = ["//runtime:__subpackages__"],  # keep
    # //bindings:_native is a Rust-built (non-Python) target Gazelle cannot
    # discover from an import statement. It must live here (not only on
    # individual test targets) so that every consumer of this py_library
    # gets //bindings/ on sys.path via Bazel's imports propagation, and
    # therefore can resolve `from kabudachi import _native`.
    deps = [
        "//bindings:_native",  # keep
        "@pypi//asgiref",  # keep
        "@pypi//protobuf",  # keep
        "@pypi//wrapt",  # keep
    ],
)
