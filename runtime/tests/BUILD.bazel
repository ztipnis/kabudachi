    srcs = ["session_world.py"],
    imports = ["."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//bindings:_native",  # keep
        "//runtime/src/kabudachi",
        "//runtime/tests:faulting_runtime",
    ],
)

py_library(
    name = "proto_messages",
    testonly = True,
    srcs = ["proto_messages.py"],
    imports = ["."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//protobuf"],
)

# aspect_rules_py's py_test does not run pytest by default: it just executes
# the file as __main__, so plain `assert`-based pytest tests would silently
# "pass" without ever calling the test function. Gazelle does not set
# pytest_main or add the pytest dep on its own, so both are hand-added and kept
# on every test below. //bindings:_native is a Rust-built (non-Python) target
# Gazelle cannot discover from the import statement, so it is added by hand too.
py_test(
    name = "test_native",
    srcs = ["test_native.py"],
    pytest_main = True,  # keep
    venv = "dev",  # keep
    deps = [
        "//bindings:_native",  # keep
        "//runtime/src/kabudachi",
        "@pypi//pytest",  # keep
    ],
)

py_test(
    name = "test_declaration",
    srcs = ["test_declaration.py"],
    pytest_main = True,  # keep
    venv = "dev",  # keep
    deps = [
        "//runtime/src/kabudachi",
        "//runtime/tests:proto_messages",
        "@pypi//pytest",  # keep
    ],
)

py_test(
