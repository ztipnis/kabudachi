# Starts and drives networked worker processes for the multi-process tests.
# gazelle:resolve py cluster //runtime/tests:cluster
py_library(
    name = "cluster",
    testonly = True,
    srcs = ["cluster.py"],
    # The program each worker process runs, as a file.
    data = ["networked_worker.py"],  # keep
    imports = ["."],
    visibility = ["//:__subpackages__"],
    deps = [
        ":networked_tasks",  # keep
        "//bindings:_native",  # keep
        "//runtime/src/kabudachi",  # keep
    ],
)

# Three real worker processes on loopback: delivers results across workers,
# kills a task process, a follower and the leader with SIGKILL, SIGSTOPs
# workers to cut one off and to leave a client unreached, compacts and
# cancels. About 35 s on a laptop, 5 s of it one record read waiting out its
# query timeout on a stopped worker.
py_test(
    name = "test_networked",
    size = "medium",
    srcs = ["test_networked.py"],
    pytest_main = True,  # keep
    venv = "dev",  # keep
    deps = [
        "//runtime/tests:cluster",
        "//runtime/tests:networked_tasks",
        "//runtime/tests:proto_messages",
        "@pypi//pytest",  # keep
    ],
)

# One worker against a real valkey server built from the BCR module; the
# server binary comes in as data. About 8 s on a laptop, 3 s of it the
# authority's TTL (set short by the URL's `ttl`), which a cold worker waits out
# before it founds its shard.
py_test(
    name = "test_networked_valkey",
    size = "medium",
    timeout = "short",
    srcs = ["test_networked_valkey.py"],
    data = ["@valkey//:valkey-server"],  # keep
    env = {"VALKEY_SERVER": "$(rlocationpath @valkey//:valkey-server)"},  # keep
    pytest_main = True,  # keep
    venv = "dev",  # keep
    deps = [
        "//runtime/tests:cluster",
        "//runtime/tests:networked_tasks",
        "//runtime/tests:proto_messages",
        "@pypi//pytest",  # keep
    ],
)

# The wheel, installed with pip into a fresh virtual environment, runs a flow
# on a worker of its own and across a networked shard of two; its metadata matches pyproject.toml, and its version
# is the one pyproject.toml, the package and MODULE.bazel name. It does not
# depend on the package's sources: everything it runs comes from the wheel.
py_test(
    name = "test_wheel",
    size = "medium",
    srcs = ["test_wheel.py"],
    data = [
        "wheel_smoke.py",
        "wheel_smoke_tasks.py",
        "//:MODULE.bazel",
        "//runtime:kabudachi_wheel",
        "//runtime:pyproject.toml",
    ],  # keep
    env = {
        "MODULE_FILE": "$(rlocationpath //:MODULE.bazel)",
        "PYPROJECT_FILE": "$(rlocationpath //runtime:pyproject.toml)",
        "WHEEL_FILE": "$(rlocationpath //runtime:kabudachi_wheel)",
    },  # keep
    pytest_main = True,  # keep
    venv = "dev",  # keep
    deps = [
        # The wheel's dependencies, linked into the environment it is
        # installed in, since the test has no network to download them.
        "@pypi//asgiref",  # keep
        "@pypi//protobuf",  # keep
        "@pypi//wrapt",  # keep
        "@pypi//packaging",  # keep
        "@pypi//pytest",  # keep
    ],
)
