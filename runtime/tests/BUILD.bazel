load("@aspect_rules_py//py:defs.bzl", "py_library", "py_test")

# gazelle:python_generation_mode file

# Shared test helper: protobuf message classes built at runtime. Tests import it
# as a top-level module, which Gazelle cannot infer.
# gazelle:resolve py proto_messages //runtime/tests:proto_messages

# Shared test adapter over the native runtime.
# gazelle:resolve py faulting_runtime //runtime/tests:faulting_runtime
py_library(
    name = "faulting_runtime",
    testonly = True,
    srcs = ["faulting_runtime.py"],
    imports = ["."],
    visibility = ["//:__subpackages__"],
    deps = ["//bindings:_native"],  # keep
)

# A session wired to a real native runtime, shared by the session, flow,
# continuation and acceptance tests.
# gazelle:resolve py session_world //runtime/tests:session_world
py_library(
    name = "session_world",
    testonly = True,
    srcs = ["session_world.py"],
    imports = ["."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//bindings:_native",  # keep
        "//runtime/src/kabudachi",
        "//runtime/tests:faulting_runtime",
    ],
)

py_library(
    name = "proto_messages",
    testonly = True,
    srcs = ["proto_messages.py"],
    imports = ["."],
    visibility = ["//:__subpackages__"],
    deps = ["@pypi//protobuf"],
)

py_test(
