load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# The libraries in this package go to CI's remote cache (CircleCI's
# with_tool_cache, billed per GB stored), so a change that leaves them alone
# does not rebuild them. Test binaries are tagged no-remote-cache: they are
# large and every job reruns the tests anyway.

rust_library(
    name = "net",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_net",
    edition = "2024",
    deps = all_crate_deps(normal = True) + ["//core"],
)

# One integration-test binary for net, with a module per area under `tests/`.
#
# Medium (300 s default timeout) gives the whole crate's tests, which share one
# process, headroom on slow CI hosts; they take about 3 s on a laptop.
# rules_rust cannot shard libtest (every shard would run the full binary), so
# there is no shard_count.
rust_test(
    name = "net_integration_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/net_integration.rs",
    edition = "2024",
    size = "medium",
    tags = ["no-remote-cache"],
    deps = [":net", "//core", "//testkit"] + all_crate_deps(normal = True, normal_dev = True),
)
