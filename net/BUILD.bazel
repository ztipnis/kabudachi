load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

# Every first-party target is tagged no-remote-cache: CI's remote cache
# (CircleCI's with_tool_cache, billed per GB stored) then holds only
# third-party outputs, which do not change between runs. The local disk
# cache still stores these targets.

rust_library(
    name = "net",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_net",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = all_crate_deps(normal = True) + ["//core"],
)

rust_test(
    name = "net_test",
    crate = ":net",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = ["//testkit"] + all_crate_deps(normal_dev = True),
)

# ":net" alone isn't enough for the tests to `use kabudachi_core::...`
# directly: unlike Cargo (where an integration test can reach any of the
# tested crate's own [dependencies]), a Bazel rust_test is a separate
# compilation unit that only sees what's explicitly in `deps`. "//core"
# mirrors the ":net" rust_library target's own `+ ["//core"]` above.
# One integration-test crate per area of net; `tests/support/**` is shared.
[
    rust_test(
        name = area + "_test",
        srcs = glob(["tests/" + area + "/**/*.rs", "tests/support/**/*.rs"]),
        crate_root = "tests/" + area + "/main.rs",
        edition = "2024",
        tags = ["no-remote-cache"],
        deps = [":net", "//core", "//testkit"] + all_crate_deps(normal = True, normal_dev = True),
    )
    for area in ["bootstrap", "election", "claim"]
]
