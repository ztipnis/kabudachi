load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "redis_authority",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "kabudachi_redis_authority",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//core"],
)

# Test-only: a valkey server per test. The binary is a data dependency, so
# every test target that links this library gets it in its runfiles.
rust_library(
    name = "valkey_test_support",
    testonly = True,
    srcs = glob(["tests/support/*.rs"]),
    crate_name = "valkey_test_support",
    crate_root = "tests/support/lib.rs",
    data = ["@valkey//:valkey-server"],
    edition = "2024",
    rustc_env = {"VALKEY_SERVER": "$(rlocationpath @valkey//:valkey-server)"},
    visibility = [
        "//net:__pkg__",
        "//redis_result_backend:__pkg__",
    ],
    deps = all_crate_deps(
        package_name = "redis_authority/tests/support",
        normal = True,
    ),
)

# Real-time tests against real servers: they sleep through TTLs of about a
# second, so medium (300 s) leaves room on a loaded CI host.
rust_test(
    name = "redis_authority_integration_test",
    size = "medium",
    # About 20 s of real-time waits; a short timeout fails a stuck server fast.
    timeout = "short",
    srcs = glob(["tests/*.rs"]),
    crate_root = "tests/redis_authority_integration.rs",
    edition = "2024",
    tags = ["no-remote-cache"],
    deps = [
        ":redis_authority",
        ":valkey_test_support",
        "//core",
        "//testkit",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
